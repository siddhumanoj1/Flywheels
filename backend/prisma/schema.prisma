generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OWNER
  MASTER_MECHANIC
  MECHANIC
}

enum JobStatus {
  PICKUP_SCHEDULED
  PICKUP_DONE
  RECEIVED
  UNDER_INSPECTION
  WORK_IN_PROGRESS
  COMPLETED
  DELIVERY_SCHEDULED
  ON_ROAD
}

enum StaffRole {
  MASTER_MECHANIC
  MECHANIC
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  LEAVE
  ABSENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  QUOTATION
  ESTIMATION
  INVOICE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PickupStatus {
  REQUESTED
  ASSIGNED
  COMPLETED
}

enum NotificationChannel {
  PUSH
  WHATSAPP
  TELEGRAM
  SYSTEM
}

model User {
  id                 String          @id @default(cuid())
  role               Role
  name               String
  phone              String          @unique
  email              String?
  dataSharingConsent Boolean         @default(false)
  address            String?
  gst                String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  cars               Car[]
  documents          Document[]      @relation("CustomerDocuments")
  notifications      Notification[]
  pickupRequests     PickupRequest[]
  loyaltyEntries     LoyaltyLedger[]
  otpCodes           OtpCode[]
  staffProfile       StaffProfile?
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
}

model Car {
  id        String     @id @default(cuid())
  userId    String
  carNumber String
  model     String
  fuelType  String
  year      Int
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  jobs      Job[]
  documents Document[]

  @@unique([userId, carNumber])
}

model Job {
  id                   String                    @id @default(cuid())
  carId                String
  status               JobStatus                 @default(RECEIVED)
  concern              String?
  expectedCompletionAt DateTime?
  pickupTime           DateTime?
  pickupRequired       Boolean                   @default(false)
  masterMechanicId     String?
  mechanicIds          Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  car                  Car                       @relation(fields: [carId], references: [id])
  masterMechanic       StaffProfile?             @relation("MasterMechanicJobs", fields: [masterMechanicId], references: [id])
  documents            Document[]
  pickupRequests       PickupRequest[]
  staffProposals       StaffAssignmentProposal[]
  workApprovalRequests WorkApprovalRequest[]
}

model PickupRequest {
  id        String       @id @default(cuid())
  userId    String
  jobId     String
  address   String
  latitude  Float?
  longitude Float?
  status    PickupStatus @default(REQUESTED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id])
  job       Job          @relation(fields: [jobId], references: [id])
}

model Document {
  id             String         @id @default(cuid())
  documentNumber String         @unique
  type           DocumentType
  customerId     String
  carId          String?
  jobId          String?
  items          Json
  subtotal       Decimal        @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  approvalStatus ApprovalStatus @default(PENDING)
  paymentStatus  PaymentStatus  @default(PENDING)
  comments       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  approvedAt     DateTime?
  customer       User           @relation("CustomerDocuments", fields: [customerId], references: [id])
  car            Car?           @relation(fields: [carId], references: [id])
  job            Job?           @relation(fields: [jobId], references: [id])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  title     String
  message   String
  channel   NotificationChannel @default(SYSTEM)
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id])
}

model LoyaltyLedger {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  barcode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffProfile {
  id                   String                    @id @default(cuid())
  userId               String                    @unique
  role                 StaffRole
  primarySkill         String
  monthlySalary        Decimal                   @db.Decimal(12, 2)
  isActive             Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id])
  masterJobs           Job[]                     @relation("MasterMechanicJobs")
  attendanceEntries    AttendanceEntry[]
  salaryAdvances       SalaryAdvance[]
  leaveRequests        LeaveRequest[]
  salarySlips          SalarySlip[]
  staffProposals       StaffAssignmentProposal[] @relation("ProposalMaster")
  workApprovalRequests WorkApprovalRequest[]
}

model AttendanceEntry {
  id               String           @id @default(cuid())
  staffId          String
  date             DateTime
  status           AttendanceStatus @default(PRESENT)
  latitude         Float?
  longitude        Float?
  faceVerified     Boolean          @default(false)
  locationVerified Boolean          @default(false)
  note             String?
  loggedAt         DateTime         @default(now())
  staff            StaffProfile     @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
}

model SalaryAdvance {
  id          String        @id @default(cuid())
  staffId     String
  amount      Decimal       @db.Decimal(12, 2)
  reason      String
  status      RequestStatus @default(PENDING)
  ownerNote   String?
  requestedAt DateTime      @default(now())
  staff       StaffProfile  @relation(fields: [staffId], references: [id])
}

model LeaveRequest {
  id          String        @id @default(cuid())
  staffId     String
  fromDate    DateTime
  toDate      DateTime
  reason      String
  status      RequestStatus @default(PENDING)
  ownerNote   String?
  requestedAt DateTime      @default(now())
  staff       StaffProfile  @relation(fields: [staffId], references: [id])
}

model SalarySlip {
  id               String       @id @default(cuid())
  staffId          String
  monthLabel       String
  grossPay         Decimal      @db.Decimal(12, 2)
  advanceDeduction Decimal      @db.Decimal(12, 2)
  leaveDeduction   Decimal      @db.Decimal(12, 2)
  netPay           Decimal      @db.Decimal(12, 2)
  generatedAt      DateTime     @default(now())
  staff            StaffProfile @relation(fields: [staffId], references: [id])
}

model StaffAssignmentProposal {
  id               String        @id @default(cuid())
  jobId            String
  masterMechanicId String
  mechanicIds      Json
  status           RequestStatus @default(PENDING)
  ownerNote        String?
  createdAt        DateTime      @default(now())
  job              Job           @relation(fields: [jobId], references: [id])
  masterMechanic   StaffProfile  @relation("ProposalMaster", fields: [masterMechanicId], references: [id])
}

model WorkApprovalRequest {
  id                  String        @id @default(cuid())
  jobId               String
  staffId             String
  title               String
  message             String
  photoPath           String?
  status              RequestStatus @default(PENDING)
  forwardedToCustomer Boolean       @default(false)
  ownerResponse       String?
  createdAt           DateTime      @default(now())
  job                 Job           @relation(fields: [jobId], references: [id])
  staff               StaffProfile  @relation(fields: [staffId], references: [id])
}
